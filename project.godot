; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vagrant 3D"
run/main_scene="res://scenes/SCENE_editor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; Android's back key does not quit the editor.
config/quit_on_go_back=false

[autoload]

Fonts="*res://scripts/autoload/AUTOLOAD_fonts.gd"

[display]

; The 1600x900 design space: the style sheet's 1280x720 at 0.8, for a tablet
; or a foldable. canvas_items + expand: a wider or taller screen gets a bigger
; viewport, nothing stretches.
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor landscape: either way up, never portrait.
window/handheld/orientation=4

[input_devices]

; Fingers arrive as InputEventScreenTouch/Drag and the S Pen (any stylus, and
; a desktop mouse) as InputEventMouse*. Neither is turned into the other: the
; editor tells them apart by class, pen for picking, fingers for the camera.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
pointing/android/enable_long_press_as_right_click=false
pointing/android/enable_pan_and_scale_gestures=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
